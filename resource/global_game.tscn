[sub_resource type="Shader" id="Shader_xnqot"]
code = "shader_type canvas_item;

uniform float time;
uniform float fade_speed = 1.0; // Speed of fade oscillation
uniform float spin_speed = 2.0; // Speed of spin

void fragment() {
    vec2 uv = UV - vec2(0.5);
    float angle = sin(TIME * spin_speed) * 0.2; // Range [-0.5, 0.5]
    uv.x += sin(uv.x * 1.0) * angle;
    vec2 rotated_uv = uv + vec2(0.5);
    vec4 tex = texture(TEXTURE, rotated_uv);
    float alpha = 0.75 + 0.25 * sin(TIME * fade_speed); // Range [0.5, 1.0]
    tex.a *= alpha;
    COLOR = tex;
}"

