[sub_resource type="GDScript" id="GDScript_v048b"]
script/source = "# ClockSpawner.gd
extends Node3D

@export var clock_mesh: Mesh         # Your clock hand mesh (e.g., a PlaneMesh)
@export var clock_material: Material # The material with your shader

const _width = 20
const _height = 20
const _spacing = 3.92

func _ready():
	var multimesh_instance = MultiMeshInstance3D.new()
	var multimesh = MultiMesh.new()
	multimesh.mesh = clock_mesh
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.use_custom_data = true
	multimesh.instance_count = _width * _height

	multimesh_instance.multimesh = multimesh
	multimesh_instance.material_override = clock_material
	add_child(multimesh_instance)

	for x in _width:
		for y in _height:
			var idx = x * _height + y
			var transform = Transform3D.IDENTITY
			transform.origin = Vector3(x * _spacing, 0, y * _spacing)
			multimesh.set_instance_transform(idx, transform)
			multimesh.set_instance_custom_data(idx, Color(randf_range(0.2,0.9), 0, 0))
"

