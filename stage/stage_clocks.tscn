[sub_resource type="Shader" id="Shader_lo47f"]
code = "shader_type spatial;

uniform sampler2D albedo_texture : filter_nearest_mipmap_anisotropic;
uniform float time;
uniform float rotation_speed = 1.0;
uniform vec3 pivot = vec3(0.0, 0.0, 0.0);


float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
void vertex() {

	//float speed = mix(0.5, 2.0, INSTANCE_CUSTOM.r); // Speed from custom value
float speed =INSTANCE_CUSTOM.r; // float(INSTANCE_ID);//INSTANCE_CUSTOM.r;
float angle = radians(TIME * rotation_speed * speed);
  //  float angle = radians(TIME * rotation_speed + NODE_POSITION_WORLD.x);
    vec3 pos = VERTEX - pivot;

    mat3 rot = mat3(
        vec3(cos(angle), 0.0, -sin(angle)),
        vec3(0.0,       1.0,  0.0),
        vec3(sin(angle), 0.0, cos(angle))
    );

    VERTEX = rot * pos + pivot;
}


void fragment() {
    vec2 uv = UV;
    vec4 tex_color = texture(albedo_texture, uv);

    ALBEDO = tex_color.rgb;
    ALPHA = tex_color.a;
}"

