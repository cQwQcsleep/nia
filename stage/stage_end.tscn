[sub_resource type="Shader" id="Shader_3mccp"]
code = "shader_type spatial;
render_mode cull_disabled, blend_add;

uniform sampler2D scroll_texture : filter_linear_mipmap_anisotropic;
uniform float scroll_speed_x = 1.0;
uniform float scroll_speed_y = 1.0;

uniform float scroll_speed_x2 = 0.3; // slower parallax layer
uniform float scroll_speed_y2 = 0.3;

uniform sampler2D emission_texture : filter_linear_mipmap_anisotropic;
uniform float emission_strength : hint_range(0.0, 5.0) = 1.0;

void fragment() {
    // --- Layer 1 UV ---
    vec2 uv1 = UV;
    uv1.x = fract(uv1.x + TIME * scroll_speed_x);
    uv1.y = fract(uv1.y + TIME * scroll_speed_y);

    // --- Layer 2 UV (parallax) ---
    vec2 uv2 = UV;
    uv2.x = fract(uv2.x + TIME * scroll_speed_x2);
    uv2.y = fract(uv2.y + TIME * scroll_speed_y2);

    // Sample both layers
    vec4 tex1 = texture(scroll_texture, uv1);
    vec4 tex2 = texture(scroll_texture, uv2);

    // Blend them (tweak 0.5 to taste)
    vec4 combined = tex1 + tex2 * 0.5;

    ALBEDO = combined.rgb;
    ALPHA = combined.a * 0.2;

    // Emission uses layer 1 UV (you can change this)
    vec4 emi = texture(emission_texture, uv1);
    EMISSION = emi.rgb * emission_strength;
}
"

