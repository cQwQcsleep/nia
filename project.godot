[internationalization]

locale/translations=PackedStringArray("res://lang/locals.de.translation", "res://lang/locals.en.translation", "res://lang/locals.ja.translation", "res://lang/locals.ru.translation")

[layer_names]

3d_physics/layer_10="obvious_invisible_wall"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
reflections/reflection_atlas/reflection_size=64
environment/ssao/quality=0
anti_aliasing/quality/use_debanding=true
textures/decals/filter=5
textures/light_projectors/filter=5
environment/glow/upscale_mode=0
lightmapping/lightmap_gi/use_bicubic_filter=false
limits/opengl/max_lights_per_object=32
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lightmapping/bake_performance/max_rays_per_pass=32
lightmapping/bake_performance/max_transparency_rays=20
lightmapping/bake_performance/max_rays_per_probe_pass=1
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=0.5

[shader_globals]

screen_texture={
"type": "sampler2D",
"value": "res://icon.svg"
}
end_train_handle_vibration_mult={
"type": "float",
"value": 0.0
}
nia_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}


