; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=2

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="nophenia"
config/description="a small dream explorer."
config/version="1.01"
run/main_scene="uid://cipj1kuvr7h06"
config/use_custom_user_dir=true
config/custom_user_dir_name="nophenia"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://b410f2c2ixjbu"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="uid://bve2qt0cqnwj"

[autoload]

game="*res://resource/global_game.tscn"
config="*res://gdscript/global_config.gd"
audio="*res://gdscript/global_audio.gd"

[debug]

file_logging/log_path="user://logs/nophenia.log"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/initial_position_type=4
window/stretch/mode="viewport"
window/handheld/orientation=1
window/handheld/keep_screen_on=true

[editor]

naming/node_name_casing=2
export/convert_text_resources_to_binary=false

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/decal_compatibility/plugin.cfg", "res://addons/jigglebones/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://audio/": "red",
"res://delete/": "red",
"res://gdscript/": "red",
"res://gdshader/": "red",
"res://lang/": "red",
"res://resource/": "red",
"res://stage/": "red",
"res://texture/": "red"
}

[global_group]

stage_lit=""
skip="skip in world loop, only show on main"
weather=""
loop_only=""
stage_lit_particle_color=""
loop_particle_restart=""

[gui]

theme/custom="uid://bsdgffnafxkqb"

[importer_defaults]

scene={
&"blender/meshes/colors": true,
&"blender/nodes/cameras": false,
&"blender/nodes/punctual_lights": false,
&"blender/nodes/visible": 1,
&"import_script/path": "uid://d71jrj8sdvhb",
&"meshes/light_baking": 2
}
texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 1.0,
"compress/mode": 1,
"compress/normal_map": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}
animation_library={
&"import_script/path": "uid://d71jrj8sdvhb"
}

